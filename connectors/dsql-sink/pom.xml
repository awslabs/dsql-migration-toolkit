<?xml version="1.0" encoding="UTF-8"?>
<!--
  Custom Aurora DSQL Kafka Connect sink connector.
  Deterministic apply logic is offline unit-tested (mvn test). Validate the live
  MSK Connect + DSQL runtime characteristics before a production deployment via
  deploy/cdc-stack.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.dsqlmigrator</groupId>
  <artifactId>dsql-sink-connector</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Custom Aurora DSQL Kafka Connect Sink Connector</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <kafka.version>3.7.0</kafka.version>
    <postgresql.version>42.7.11</postgresql.version>
    <aws.sdk.version>2.31.0</aws.sdk.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <!-- Kafka Connect API (provided by the MSK Connect runtime). -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>connect-api</artifactId>
      <version>${kafka.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- PostgreSQL JDBC driver: DSQL speaks the PostgreSQL wire protocol. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>

    <!-- AWS SDK v2 DSQL client for IAM auth-token generation (DsqlUtilities). -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dsql</artifactId>
      <version>${aws.sdk.version}</version>
    </dependency>

    <!-- AWS SDK v2 CloudWatch: emit the per-table NetRowsApplied monitor metric
         (best-effort). Shaded into the plugin jar like the DSQL client. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>cloudwatch</artifactId>
      <version>${aws.sdk.version}</version>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.13</version>
      <scope>provided</scope>
    </dependency>

    <!-- Test only. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <!-- Shade non-provided deps (PG driver, AWS SDK) into the plugin jar
           uploaded to S3 for the MSK Connect custom plugin. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
