# Secrets / local config
.env
.env.*

# Seed utility log
scripts/seed.log

# E2E runtime artifacts (may contain source coordinates; never committed)
typetest_failrows.json
e2e_watermark.json

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# OS / editor cruft
.DS_Store

# Runtime-generated local state (default paths from config.py): per-session
# job/snapshot stores and the activity log. Regenerated on run; never committed.
job_state.sqlite
session_state.sqlite
migration_activity.log

# --- Connector plugins ------------------------------------------------------
# NOTE: the deploy-critical plugin ZIPs are COMMITTED on purpose, not ignored:
#   connectors/plugins/debezium-mysql-plugin.zip
#   connectors/plugins/dsql-sink-plugin.zip
#   connectors/plugins/offset-seeder-lambda.zip
# s3_provision.py uploads these exact files to S3 for the CDC stack, so a fresh
# clone can deploy without a Java/Maven toolchain (deployment-convenience first).
#
# Ignore ONLY the regenerable intermediates that the deploy never reads directly:
#  - the Glue converter jar (mvn-downloaded; already bundled INSIDE both zips).
#    Unanchored so it is ignored wherever the build script copies it, including
#    inside connectors/plugins/debezium-connector-mysql/.
#  - the dsql-sink-plugin/ staging dir (the build script `rm -rf`s and recreates
#    it from the sink jar + converter; pure staging, not a source input).
#  - the Maven build output for the sink.
#  - dependency-reduced-pom.xml: the maven-shade-plugin writes this "effective pom"
#    to the module root (NOT target/) on every `mvn package`; nothing reads it.
# The committed inputs that DO stay: the three deploy zips above, the
# connectors/plugins/debezium-connector-mysql/ input folder (the real Debezium
# jars the build script does NOT fetch), and connectors/dsql-sink/src/.
schema-registry-kafkaconnect-converter-*.jar
connectors/plugins/dsql-sink-plugin/
connectors/dsql-sink/target/
connectors/dsql-sink/dependency-reduced-pom.xml

# --- E2E orchestrator runtime artifacts -------------------------------------
# Regenerated on every run of scripts/run_e2e_migration.py (binlog watermark,
# workload pidfile). Not source; the watermark also carries live binlog/GTID
# coordinates that should not be committed.
e2e_watermark.json
e2e_workload.pid
# PKs of the intentional-failure rows seeded by scripts/seed_migration_typetest.py
# (regenerated each seed run; carries no source values, just PKs).
typetest_failrows.json
# Landmark PKs seeded by scripts/seed_fullload_edgecases.py and the partial
# chunk/watermark snapshots written by scripts/run_fullload_resume_harness.py
# (regenerated each run; PKs + binlog coordinates, not source — never commit).
edge_landmarks.json
resume_watermark.json
# Table classification manifest written by scripts/seed_schema_edgecases.py
# (regenerated each seed run; table names + generated long-identifier names, not source).
schema_edge_manifest.json
resume_partial_chunks.json
# Working brief for a resumed session. Carries environment specifics (bastion /
# security-group IDs, VPC, notes) that must NOT be committed; deleted when its
# work lands. Ignored so a blanket `git add -A` can never capture it.
RESUME_CONTEXT.md
# Internal release-readiness review notes (produced by another tool). Not for the
# public repo; ignored so a blanket `git add -A` can never capture it.
docs/public-release-readiness-review-*.md
# Editable draw.io architecture sources are NOT shared publicly -- only the
# rendered PNGs (docs/images/architecture-aws*.png) are committed for readers.
*.drawio
# Per-environment CDC deploy parameter files (account id, real ARNs, VPC/subnet
# ids, MSK bootstrap). Regenerated per environment; not source — never commit.
# Broad glob so ANY *params*.json under the cdc-stack tree is ignored (not just
# the e2e/ subdir), preventing a repeat of committed real infra identifiers.
deploy/cdc-stack/**/saved-params*.json
deploy/cdc-stack/*params*.json

# Editor/tool backup + scratch artifacts (never source).
*.bak
*.bak[0-9]
*.bkp
.$*


# Internal design/spec artifacts (Kiro) — not published
.kiro/

# Developer-only runbooks (hands-on QA procedures the author runs, not customer
# deployment docs) — kept locally, not published.
docs/dev/

# Agent guidance for Claude Code (local dev aid, not a published doc)
CLAUDE.md

# Internal operational/test scripts are not published. Only the customer-facing
# read-only verification helpers are tracked (see scripts/README.md).
scripts/*
!scripts/_common.py
!scripts/_e2e_tables.py
!scripts/compare_rows.py
!scripts/verify_conversion_on_dsql.py
!scripts/measure_performance.py
!scripts/run_full_load.py
!scripts/run_pg_cdc_e2e.py
!scripts/release_gate.py
!scripts/cdc_consistency_check.py
!scripts/cdc_throughput_test.py
!scripts/cdc_workload_customers_sample_new.py
!scripts/README.md
!scripts/README.ko.md

# Local Claude Code skills/config (dev aid, not published)
.claude/

# Local performance measurement outputs (not published)
perf-runs/

# Personal editor Task (grip -> Chrome Markdown preview); not shared. The
# tracked .vscode/settings.json stays committed.
.vscode/tasks.json

# Playwright MCP browser scratch artifacts (console/page dumps)
.playwright-mcp/
